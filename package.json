{
  "name": "subagent-win",
  "version": "0.3.0",
  "type": "module",
  "description": "Windows-compatible pi subagent extension: single/parallel/async execution, per-call model override, external CLI backends (Claude Code / Codex / Antigravity / AtomCode), Codex header compat, and workflow orchestration.",
  "keywords": [
    "pi-package",
    "subagent",
    "windows",
    "workflow",
    "claude",
    "codex",
    "agy",
    "atomcode"
  ],
  "license": "MIT",
  "author": "Annacomnena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annacomnena/pi-subagents-win.git"
  },
  "homepage": "https://github.com/annacomnena/pi-subagents-win#readme",
  "bugs": {
    "url": "https://github.com/annacomnena/pi-subagents-win/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "prepare:test-deps": "node ./scripts/ensure-pi-test-deps.mjs",
    "smoke:wiki-nav": "node ./scripts/ensure-pi-test-deps.mjs && node --experimental-strip-types ./extensions/_smoke_wiki_nav.ts",
    "smoke:wiki-semantic": "node ./scripts/ensure-pi-test-deps.mjs && node --experimental-strip-types ./extensions/_smoke_wiki_semantic.ts",
    "smoke:reclaim-loop": "node --experimental-strip-types ./extensions/_smoke_reclaim_loop.ts",
    "smoke:real-tab": "node ./scripts/real-tab-smoke.mjs",
    "test:launch": "node --experimental-strip-types ./extensions/_test_launch.ts",
    "test:runtime-core": "node --experimental-strip-types ./extensions/_test_runtime_core.ts",
    "test:runtime-journal": "node --experimental-strip-types ./extensions/_test_runtime_journal.ts",
    "test:runtime-projector": "node --experimental-strip-types ./extensions/_test_runtime_projector.ts",
    "test:capabilities": "node --experimental-strip-types ./extensions/_test_capabilities.ts",
    "test:runner-tools": "node --experimental-strip-types ./extensions/_test_runner_tools.ts",
    "test:trace-worker": "node --experimental-strip-types ./extensions/_test_trace_worker.ts",
    "test:trace-fusion-git": "node --experimental-strip-types ./extensions/_test_trace_fusion_git.ts",
    "test:trace-fusion-launch": "node --experimental-strip-types ./extensions/_test_trace_fusion_launch.ts",
    "test:trace-fusion-collect": "node --experimental-strip-types ./extensions/_test_trace_fusion_collect.ts",
    "test:trace-fusion-crosstest": "node --experimental-strip-types ./extensions/_test_trace_fusion_crosstest.ts",
    "test:trace-fusion-supervisor": "node --experimental-strip-types ./extensions/_test_trace_fusion_supervisor.ts",
    "test:hotspot": "node --experimental-strip-types ./extensions/hotspot/_test_hotspot.ts",
    "test:lite-mode": "node --experimental-strip-types ./extensions/_test_lite_mode.ts",
    "test:external-cli": "node --experimental-strip-types ./extensions/_test_external_cli.ts",
    "test:tab-runs": "node --experimental-strip-types ./extensions/_test_tab_runs.ts",
    "test:tab-runs-runtime": "node --experimental-strip-types ./extensions/_test_tab_runs_runtime.ts",
    "test:timers": "node --experimental-strip-types ./extensions/_test_timers.ts",
    "test:timers-runtime": "node --experimental-strip-types ./extensions/_test_timers_runtime.ts",
    "test:async-panel": "node --experimental-strip-types ./extensions/_test_async_panel.ts",
    "test:links": "node --experimental-strip-types ./extensions/_test_links.ts",
    "test:event-bus": "node --experimental-strip-types ./extensions/_test_event_bus.ts",
    "test:report": "node --experimental-strip-types ./extensions/_test_report.ts",
    "test:identity": "node --experimental-strip-types ./extensions/_test_identity.ts",
    "test:register-graph": "node ./scripts/ensure-pi-test-deps.mjs && node --experimental-strip-types ./extensions/_test_register_graph.ts",
    "smoke:extension-load": "node ./scripts/check-extension-load.mjs",
    "test:runtime-protocol": "node --experimental-strip-types ./extensions/_test_runtime_protocol.ts",
    "test:runtime-mailbox": "node --experimental-strip-types ./extensions/_test_runtime_mailbox.ts",
    "test:runtime-registry": "node --experimental-strip-types ./extensions/_test_runtime_registry.ts",
    "test:runtime-consumer": "node --experimental-strip-types ./extensions/_test_runtime_consumer.ts",
    "test:runtime-cutover": "node --experimental-strip-types ./extensions/_test_runtime_cutover.ts",
    "test:runtime-master-control": "node --experimental-strip-types ./extensions/_test_runtime_master_control.ts",
    "test:runtime-master-transfer": "node --experimental-strip-types ./extensions/_test_runtime_master_transfer.ts",
    "test:runtime-workstream": "node --experimental-strip-types ./extensions/_test_runtime_workstream.ts",
    "test:runtime-hydrate": "node --experimental-strip-types ./extensions/_test_runtime_hydrate.ts",
    "test:runtime-wake": "node --experimental-strip-types ./extensions/_test_runtime_wake.ts"
  },
  "dependencies": {
    "usearch": "2.26.0"
  }
}
