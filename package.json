{
  "name": "subagent-win",
  "version": "0.2.1",
  "type": "module",
  "description": "Windows-compatible pi subagent extension: single/parallel/async execution, per-call model override, external CLI backends (Claude Code / Codex / Antigravity / AtomCode), Codex header compat, and workflow orchestration.",
  "keywords": [
    "pi-package",
    "subagent",
    "windows",
    "workflow",
    "claude",
    "codex",
    "agy",
    "atomcode"
  ],
  "license": "MIT",
  "author": "Annacomnena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annacomnena/pi-subagents-win.git"
  },
  "homepage": "https://github.com/annacomnena/pi-subagents-win#readme",
  "bugs": {
    "url": "https://github.com/annacomnena/pi-subagents-win/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "prepare:test-deps": "node ./scripts/ensure-pi-test-deps.mjs",
    "smoke:wiki-nav": "node ./scripts/ensure-pi-test-deps.mjs && node --experimental-strip-types ./extensions/_smoke_wiki_nav.ts",
    "smoke:wiki-semantic": "node ./scripts/ensure-pi-test-deps.mjs && node --experimental-strip-types ./extensions/_smoke_wiki_semantic.ts",
    "test:launch": "node --experimental-strip-types ./extensions/_test_launch.ts",
    "test:external-cli": "node --experimental-strip-types ./extensions/_test_external_cli.ts",
    "test:tab-runs": "node --experimental-strip-types ./extensions/_test_tab_runs.ts"
  },
  "dependencies": {
    "usearch": "2.26.0"
  }
}
