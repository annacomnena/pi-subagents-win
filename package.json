{
  "name": "subagent-win",
  "version": "0.8.0",
  "type": "module",
  "description": "Windows-compatible pi subagent extension: single/parallel/async execution, per-call model override, external CLI backends (Claude Code / Codex / Antigravity / AtomCode), workflow orchestration, and an autonomy control plane (heartbeat + supervision ledger) that dispatches from a global master to per-repo local masters.",
  "keywords": [
    "pi-package",
    "subagent",
    "windows",
    "workflow",
    "claude",
    "codex",
    "agy",
    "atomcode"
  ],
  "license": "MIT",
  "author": "Annacomnena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annacomnena/pi-subagents-win.git"
  },
